# Optional. Copy to .env.local and uncomment what you need; Vite reads it at startup.

# API base URL. Defaults to /api, which the dev server proxies to the backend.
# VITE_API_URL=https://api.example.com/api
# CARTO basemaps key (free at https://carto.com/basemaps/apikey). When set, the basemap switcher offers the old
# Atlas's Carto Voyager.
# VITE_CARTO_API_KEY=
