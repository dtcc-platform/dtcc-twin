# Copy to .env before the first `pnpm dev`.

# --- Required ---

# Matches the postgres service in compose.yaml.
DATABASE_URL=postgres://app:app@localhost:5432/app
# Matches the valkey service in compose.yaml.
VALKEY_URL=redis://localhost:6379
# Signs the access tokens. At least 32 characters.
JWT_SECRET=development-only-secret-never-use-in-production

# --- Optional (has defaults) ---

# development | test | production
NODE_ENV=development
# The frontend dev server proxies /api to this port.
PORT=3030
# Comma-separated bare origins, such as https://app.example.com. Empty is fine locally: the dev server proxies /api.
CORS_ORIGINS=
# Where downloaded job packages are kept, relative to apps/backend.
PACKAGE_STORAGE_DIR=.data/packages
# Job submissions each user can make per clock hour, admins included.
JOB_LIMIT_PER_HOUR=10

# --- DTCC Engine ---

# Empty means no engine: the Dataset and job routes answer 503. For `pnpm dev:engine`, use http://127.0.0.1:8000.
ENGINE_URL=
# The engine's shared token; `pnpm dev:engine` uses local-dev-engine-token.
ENGINE_API_TOKEN=
ENGINE_GATEWAY_KEY=

# --- API gateway ---

# APISIX's Admin API, where API keys are issued and revoked. Empty means no gateway: the key routes answer 503. For the dtcc-infra demo, use http://127.0.0.1:9180.
APISIX_ADMIN_URL=
# The Admin API's key; the dtcc-infra demo's is APISIX_ADMIN_KEY in its .env.
APISIX_ADMIN_KEY=

# --- First administrator ---

# `node dist/migrate.js` creates this active admin when the database has none; afterwards it changes nothing.
ADMIN_EMAIL=
ADMIN_PASSWORD=

AGENT_MODEL_PROVIDER=scripted
AWS_BEARER_TOKEN_BEDROCK=
AGENT_BEDROCK_REGION=eu-north-1
ANTHROPIC_API_KEY=
AGENT_MODEL=

AGENT_DATASETS=city
AGENT_JOB_WAIT_MS=45000
AGENT_MAX_MODEL_MB=512

AGENT_MAX_AREA_KM2=5
AGENT_QUESTIONS_PER_DAY=100

AGENT_RESUME_INTERVAL_SECONDS=5
