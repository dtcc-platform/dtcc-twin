# Copy to .env before the first `pnpm dev`.

# --- Required ---

# Matches the postgres service in compose.yaml.
DATABASE_URL=postgres://app:app@localhost:5432/app
# Signs the access tokens. At least 32 characters.
JWT_SECRET=development-only-secret-never-use-in-production

# --- Optional (has defaults) ---

# development | test | production
NODE_ENV=development
# The frontend dev server proxies /api to this port.
PORT=3030
# Comma-separated bare origins, such as https://app.example.com. Empty is fine locally: the dev server proxies /api.
CORS_ORIGINS=
